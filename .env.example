OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Needed only for an organisation-level Anthropic key (one not created inside a workspace): the workspace's id
# ANTHROPIC_WORKSPACE_ID=
NVIDIA_API_KEY=
# Which provider runs the LLM roles: openai (GPT) or anthropic (Claude). One role can be overridden, e.g.
# UA_PROVIDER_VERIFY=openai to let GPT verify lessons Claude wrote. Each provider has its own prompt set (app/prompts/).
# UA_LLM_PROVIDER=openai
# UA_PROVIDER_VISION= / UA_PROVIDER_GRAPH= / UA_PROVIDER_LESSON= / UA_PROVIDER_VIZ= / UA_PROVIDER_VERIFY=
# Anthropic models and efforts (low/medium/high/xhigh/max; defaults shown)
# UA_ANTHROPIC_MODEL_VISION=claude-haiku-5-5
# UA_ANTHROPIC_MODEL_GRAPH=claude-opus-5-5
# UA_ANTHROPIC_MODEL_LESSON=claude-opus-5-5
# UA_ANTHROPIC_MODEL_VIZ=claude-opus-5-5
# UA_ANTHROPIC_MODEL_VERIFY=claude-haiku-5-5
# UA_ANTHROPIC_EFFORT_GRAPH=high
# UA_ANTHROPIC_CACHE_TTL=1h
# OpenAI models and efforts (defaults shown)
# UA_MODEL_VISION=gpt-6-luna
# UA_MODEL_GRAPH=gpt-6.1-sol
# UA_MODEL_LESSON=gpt-6.1-sol
# UA_MODEL_VIZ=gpt-6.1-sol
# UA_MODEL_VERIFY=gpt-6-luna
# UA_EFFORT_GRAPH=high
# UA_PARSE_ENGINE=auto
# UA_LLM_CONCURRENCY=6
# UA_FAKE_LLM=0
# Where things live. Book PDFs: UA_BOOKS_DIR (default <project>/books; a relative path is taken from the project root).
# Database, course files and page renders: UA_DATA_DIR (default ~/Library/Application Support/UniversalAcademy on
# macOS, ~/.local/share/universal-academy elsewhere). On a server, set both, to persistent, backed-up folders: with a
# custom UA_DATA_DIR and no UA_BOOKS_DIR, books are kept in <data>/books.
# UA_BOOKS_DIR=books
# UA_DATA_DIR=
